#include <winver.h>
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "MdAmp Project\0"
      VALUE "FileDescription", "MdAmp Audio Player\0"
      VALUE "FileVersion", "@MDAMP_VERSION@\0"
      VALUE "InternalName", "MdAmp\0"
      VALUE "OriginalFilename", "MdAmp.exe\0"
      VALUE "ProductName", "MdAmp\0"
      VALUE "ProductVersion", "@MDAMP_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
